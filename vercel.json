{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/comparison", "destination": "/index.html" },
    { "source": "/diagnosis", "destination": "/index.html" },
    { "source": "/diagnosis/method", "destination": "/index.html" },
    { "source": "/runs", "destination": "/index.html" },
    { "source": "/runs/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
