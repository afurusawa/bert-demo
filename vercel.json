{
  "rewrites": [
    { "source": "/runs", "destination": "/index.html" },
    { "source": "/runs/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
